# Copy to .env.local. NEVER commit .env.local or any backup of it.
# .gitignore covers .env, .env.local and .env*.backup*.
#
# Every value is trimmed on read: a trailing newline pasted into a dashboard
# field breaks webhook auth silently and the workflow looks guilty for hours.

# ── Contact enquiries -> n8n (secrets) ─────────────────────────────────────
# While CONTACT_N8N_WEBHOOK_URL or CONTACT_N8N_AUTH_HEADER_VALUE is empty,
# POST /api/contact returns 503 and tells the visitor the message was NOT sent.
# It never returns a success it cannot back up.
#
# Named CONTACT_* rather than the skill asset's CHAT_* because this site has no
# chat feature; the contract is otherwise identical to the skill's n8n guidance.
CONTACT_N8N_WEBHOOK_URL=
CONTACT_N8N_AUTH_HEADER_NAME=x-server-key
CONTACT_N8N_AUTH_HEADER_VALUE=
CONTACT_N8N_SHARED_SECRET=            # >= 16 chars; HMAC-SHA256 over "${timestamp}.${body}"
                                      # sent as x-timestamp + x-signature. Shorter is treated as unset.

# ── n8n workflow notes ─────────────────────────────────────────────────────
# The payload is { kind: "contact", to, replyTo, subject, text, enquiry, receivedAt }.
# Fork on `kind` BEFORE any chat validator: a validator that requires sessionId
# will reject a contact payload.
# `to` is brand.email from src/config/brand.ts, which is still empty — set it
# before wiring the webhook or the workflow has no destination address.

# ── Set by Vercel ──────────────────────────────────────────────────────────
# VERCEL_ENV=production   (SITE_IS_INDEXABLE requires this AND brand.domain)
